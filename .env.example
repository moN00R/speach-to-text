# ── Whisper STT ───────────────────────────
APP_WHISPER_MODEL_SIZE=base          # tiny | base | small | medium | large-v3
APP_WHISPER_DEVICE=cpu               # cpu | cuda
APP_WHISPER_COMPUTE_TYPE=int8        # int8 (cpu) | float16 (gpu)
APP_WHISPER_LANGUAGE=ar              # default language

# ── Ollama LLM ───────────────────────────
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=gemma:2b            # or qwen:1.8b

# ── Piper TTS ────────────────────────────
APP_PIPER_BINARY=piper
APP_PIPER_MODEL=ar_JO-kareem-medium.onnx

# ── Server ────────────────────────────────
APP_MAX_AUDIO_SIZE_MB=25
